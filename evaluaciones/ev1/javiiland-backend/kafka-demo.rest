@baseUrl = http://localhost:8080

### 0. Login ADMIN (Ejecuta este primero para capturar el token automáticamente)
# @name login
POST {{baseUrl}}/api/usuarios/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### Variable dinámica del token (si tu DTO devuelve "accessToken", cambia ".token" por ".accessToken")
@token = {{login.response.body.token}}

###############################################################################
### ESCENARIO 1: Crear catálogo de equipos y listar
###############################################################################

### 1.1 Crear Inflable Castillo (límite 3 usos)
POST {{baseUrl}}/api/equipos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Inflable Castillo",
  "limiteUsos": 3
}

### 1.2 Crear Taca-Taca #2 (límite 10 horas)
POST {{baseUrl}}/api/equipos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Taca-Taca #2",
  "limiteHoras": 10
}

### 1.3 Listar todos los equipos (verificar IDs y contadores)
GET {{baseUrl}}/api/equipos
Authorization: Bearer {{token}}

###############################################################################
### ESCENARIO 2: Reserva con equipos (flujo normal -> evento USO)
###############################################################################

### 2.1 Crear Reserva #1 (suma 1 uso al equipo 1 y 4 horas al equipo 2)
POST {{baseUrl}}/api/reservas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reservationDate": "2026-12-10",
  "eventName": "Cumpleaños de Sofía",
  "description": "Demo Kafka",
  "equipos": [
    { "equipoId": 1, "horas": 4 },
    { "equipoId": 2, "horas": 4 }
  ]
}

###############################################################################
### ESCENARIO 3: Bloqueo automático por límite de usos
###############################################################################

### 3.1 Crear Reserva #2 con Inflable Castillo (llega a 2/3 usos)
POST {{baseUrl}}/api/reservas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reservationDate": "2026-12-11",
  "eventName": "Demo 2026-12-11",
  "equipos": [
    { "equipoId": 1, "horas": 3 }
  ]
}

### 3.2 Crear Reserva #3 con Inflable Castillo (llega a 3/3 -> bloquea desde 2026-12-13)
POST {{baseUrl}}/api/reservas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reservationDate": "2026-12-12",
  "eventName": "Demo 2026-12-12",
  "equipos": [
    { "equipoId": 1, "horas": 3 }
  ]
}

### 3.3 Intentar reservar el equipo 1 el 2026-12-13 (Debe devolver 409 Conflict)
POST {{baseUrl}}/api/reservas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reservationDate": "2026-12-13",
  "eventName": "Debe fallar",
  "equipos": [
    { "equipoId": 1, "horas": 2 }
  ]
}

###############################################################################
### ESCENARIO 4: Reporte de falla por operario (202 Accepted -> evento FALLA)
###############################################################################

### 4.1 Reportar falla en Taca-Taca #2 (equipo 2)
POST {{baseUrl}}/api/equipos/2/falla
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "detalle": "El motor del Taca-Taca hace ruido"
}

### 4.2 Consultar alertas de mantenimiento pendientes
GET {{baseUrl}}/api/mantenimiento/alertas
Authorization: Bearer {{token}}

###############################################################################
### ESCENARIO 5: Cerrar mantención (vuelve a DISPONIBLE y reinicia contadores)
###############################################################################

### 5.1 Cerrar mantención del Inflable Castillo (equipo 1)
POST {{baseUrl}}/api/equipos/1/mantencion/cerrar
Authorization: Bearer {{token}}

###############################################################################
### ESCENARIO 6: Cancelación de reserva (evento REVERSA)
###############################################################################

### 6.1 Cancelar reserva ID 1 (ajusta el ID si corresponde)
PUT {{baseUrl}}/api/reservas/1/cancelar
Authorization: Bearer {{token}}

###############################################################################
### ESCENARIO 9: Administración de tópicos por API
###############################################################################

### 9.1 Listar tópicos de Kafka
GET {{baseUrl}}/api/admin/kafka/topics
Authorization: Bearer {{token}}

### 9.2 Crear tópico de prueba
POST {{baseUrl}}/api/admin/kafka/topics
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "prueba-admin",
  "partitions": 2,
  "replicationFactor": 3,
  "configs": {
    "retention.ms": "86400000"
  }
}

### 9.3 Aumentar particiones y retención
PATCH {{baseUrl}}/api/admin/kafka/topics/prueba-admin
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "partitions": 4,
  "configs": {
    "retention.ms": "172800000"
  }
}

### 9.4 Eliminar tópico de prueba
DELETE {{baseUrl}}/api/admin/kafka/topics/prueba-admin
Authorization: Bearer {{token}}